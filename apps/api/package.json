{
  "name": "walkspot-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "//test": "The glob is quoted so Node expands it, not the shell — an unquoted src/**/*.test.ts degrades to one level deep in sh and silently skips nested tests. Needs Node 22+.",
    "test": "tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@sentry/node": "^10.69.0",
    "@supabase/supabase-js": "^2.108.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
