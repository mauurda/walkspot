# Walkspot API — copy to .env (never commit the filled-in file).

# Supabase project. The service-role key bypasses RLS: server-side only. The
# client never talks to Supabase directly except to PUT a file to a signed
# upload URL the API minted.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Walking-route geometry. Any OSRM-compatible server; the default is the
# FOSSGIS foot profile that openstreetmap.org itself uses for directions
# (fair use — fine for hunts, not for a routing product). Empty = straight
# lines only.
ROUTING_URL=https://routing.openstreetmap.de/routed-foot

# Sentry DSN for the API project. Empty = Sentry off.
SENTRY_DSN=

# Local dev only — Vercel sets PORT itself.
PORT=4000
