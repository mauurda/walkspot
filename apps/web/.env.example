# Walkspot — copy to .env.local (never commit the filled-in file). Vercel
# reads the same names from the project's environment variables.

# Supabase project. The service-role key bypasses RLS: it is read only by the
# route handlers under app/api and never reaches the browser.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Walking-route geometry. Any OSRM-compatible server; the default is the
# FOSSGIS foot profile that openstreetmap.org itself uses for directions
# (fair use — fine for hunts, not for a routing product). Empty = straight
# lines only.
ROUTING_URL=https://routing.openstreetmap.de/routed-foot

# Sentry. One project; the DSN is safe to expose (it only accepts events).
# Empty = Sentry off on both sides.
NEXT_PUBLIC_SENTRY_DSN=
